# Optional. When set, the reasoning agent (backend/app/agent/graph.py) uses
# the real Claude API via LangGraph for explanation/recommendation text.
# When unset, it falls back to deterministic template-based reasoning
# (backend/app/agent/fallback.py) — the app is fully functional either way.
ANTHROPIC_API_KEY=

# Defaults to a local SQLite file if unset. Point this at Postgres for a
# production-like setup — see ../docker-compose.yml.
DATABASE_URL=sqlite:///./apoe.db
